# VITE_API_URL should point to the backend API (with /api suffix)
# VITE_API_BASE should point to the backend base URL (without /api suffix)
# Leave commented to use localhost defaults during development

# Production (uncomment and set your backend URL):
# VITE_API_URL=https://your-backend.railway.app/api
# VITE_API_BASE=https://your-backend.railway.app
